<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Same solid color as the splash / cold-start window so there is no flash before Compose draws. -->
    <style name="Theme.DatingApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_screen_background</item>
        <item name="android:statusBarColor">@color/splash_screen_background</item>
        <item name="android:navigationBarColor">@color/splash_screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
      AndroidX Core SplashScreen: use BOTH androidx and android:* items so the branded
      drawable is always chosen (avoids falling back to sym_def_app_icon on some API levels).
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_screen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_safe_zone</item>
        <item name="android:windowSplashScreenBackground">@color/splash_screen_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_safe_zone</item>
        <item name="postSplashScreenTheme">@style/Theme.DatingApp</item>
    </style>
</resources>