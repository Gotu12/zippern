<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1:1 / audio / non-PK: full-screen remote + PIP local -->
    <FrameLayout
        android:id="@+id/standard_call_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remote_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/local_view_card"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/local_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!--
        PK Battle: vertical split — top = arena (host | guest), bottom = audience (Compose).
        Weights 11:9 (55% arena / 45% audience) to align with LiveScreen PK split.
    -->
    <LinearLayout
        android:id="@+id/pk_split_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="11">

            <LinearLayout
                android:id="@+id/pk_arena_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="2">

                <org.webrtc.SurfaceViewRenderer
                    android:id="@+id/pk_host_view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <org.webrtc.SurfaceViewRenderer
                    android:id="@+id/pk_challenger_view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_pk_arena_hud"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pk_audience_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            android:background="@android:color/transparent">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_pk_audience"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

    <!-- Standard call: top bar — hidden in PK mode (content moves into audience panel). -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_overlay_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Standard call: bottom chat — height pinned in code for video (~45% screen); min/max avoid tiny slot / overflow. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_overlay_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:minHeight="260dp"
        android:maxHeight="520dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Above standard + PK layers so gifts show in PK mode (standard_call_container is GONE). -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_gift_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
