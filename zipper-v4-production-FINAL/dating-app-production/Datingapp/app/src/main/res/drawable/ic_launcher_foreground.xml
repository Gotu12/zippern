<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — the full Zipper Live logo bitmap.
  android:gravity="center" with a small inset ensures the logo stays
  within the 72dp safe zone so no important content is clipped by the
  launcher's shape mask (circle / squircle / teardrop, etc.).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/zipper_logo"
    android:insetLeft="4dp"
    android:insetTop="4dp"
    android:insetRight="4dp"
    android:insetBottom="4dp" />
