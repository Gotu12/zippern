<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen icon (android:windowSplashScreenAnimatedIcon).
  On Android 12+ the system renders this inside a ~160dp circle on the
  windowSplashScreenBackground colour. The logo is padded with 20dp so
  the zipper border and all text remain visible inside the circle.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/zipper_logo"
    android:insetLeft="20dp"
    android:insetTop="20dp"
    android:insetRight="20dp"
    android:insetBottom="20dp" />
