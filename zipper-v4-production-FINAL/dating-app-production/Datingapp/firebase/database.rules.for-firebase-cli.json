{
  "rules": {
    ".read": false,
    ".write": false,
    "pk_queue": {
      ".read": true,
      ".write": true
    },
    "pk_matches": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "call_invites": {
      "$receiverId": {
        ".read": true,
        ".write": true
      }
    },
    "call_responses": {
      "$callerId": {
        ".read": true,
        ".write": true
      }
    },
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true
      }
    },
    "live_publishers": {
      "$sessionId": {
        "$publisherUid": {
          ".read": true,
          ".write": true
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    ".info": {
      "connected": {
        ".read": true
      }
    }
  }
}
